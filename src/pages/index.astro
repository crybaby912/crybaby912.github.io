---
import { featuredProject, projects } from '../data/projects';
import '../styles/site.css';

const categories = ['ALL', ...new Set(projects.map((project) => project.category))];
const totalIncidents = projects.reduce((count, project) => count + project.incidents.length, 0);
const totalEvidence = projects.reduce((count, project) => count + project.evidence.length, 0);
const pageTitle = 'CRYBABY912 / 全栈与 AI 工程作品集';
const pageDescription = 'CRYBABY912 的个人项目作品集，记录全栈系统、AI 应用和真实工程问题的解决过程。';
const canonicalURL = new URL('/', Astro.site);
const socialImage = new URL(featuredProject.cover, Astro.site);

const methodSteps = [
  { title: '先把问题说清楚', body: '从用户动作、数据流和失败状态开始，把“想做一个功能”收敛成可以验证的边界。' },
  { title: '再让系统跑起来', body: '优先建立端到端链路，再补齐权限、并发、缓存、外部依赖和可观测性。' },
  { title: '最后留下证据', body: '用回归测试、压测、日志和复盘记录说明它为什么可靠，也说明它还没解决什么。' },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#f5f2ea" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#content">跳到主要内容</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="container">
          <a class="brand" href="#top" aria-label="返回首页"><span class="brand-mark">C9</span><span>CRYBABY912</span></a>
          <nav id="site-nav" class="site-nav" aria-label="主导航">
            <a href="#work">项目 <span>01</span></a>
            <a href="#approach">方法 <span>02</span></a>
            <a href="#about">关于 <span>03</span></a>
            <a class="nav-contact" href="https://github.com/crybaby912" target="_blank" rel="noreferrer">GitHub ↗</a>
          </nav>
          <button class="menu-toggle" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="site-nav"><span>MENU</span><span class="menu-icon">+</span></button>
        </div>
      </header>

      <main id="content">
        <section class="home-hero" aria-labelledby="hero-title">
          <div class="container hero-grid">
            <div>
              <p class="eyebrow">FULL-STACK / AI / PRODUCT ENGINEERING</p>
              <h1 id="hero-title" class="hero-title">把复杂业务，<br /><em>做成能被验证的系统。</em></h1>
              <p class="hero-copy">这里不是功能截图墙，而是我在两个真实项目里如何建模、排错、取舍和交付的记录。每个案例都包含实现路径、关键 Bug 和可以复核的结果。</p>
              <div class="hero-actions">
                <a class="button button-primary" href="#work">查看项目 <span>↓</span></a>
                <a class="button button-quiet" href="https://github.com/crybaby912" target="_blank" rel="noreferrer">GitHub ↗</a>
              </div>
            </div>
            <aside class="hero-aside" aria-label="当前精选项目">
              <div class="hero-aside-head"><p class="section-label">FEATURED CASE</p><span class="hero-aside-year">{featuredProject.year}</span></div>
              <h2 class="hero-aside-title">{featuredProject.title}</h2>
              <p class="hero-aside-focus">{featuredProject.description}</p>
              <p class="hero-aside-copy">{featuredProject.summary}</p>
              <div class="hero-aside-stats">
                <div><strong>{projects.length}</strong><span>PROJECTS</span></div>
                <div><strong>{totalIncidents}</strong><span>BUG NOTES</span></div>
                <div><strong>{totalEvidence}</strong><span>EVIDENCE</span></div>
              </div>
            </aside>
          </div>
        </section>

        <section class="signal-bar" aria-label="项目概览">
          <div class="container signal-grid">
            <div class="signal-item"><span class="signal-value">{projects.length}</span><span class="signal-label">完整项目案例</span></div>
            <div class="signal-item"><span class="signal-value">DAG + Commerce</span><span class="signal-label">两类系统问题</span></div>
            <div class="signal-item"><span class="signal-value">CI / k6</span><span class="signal-label">工程验证证据</span></div>
            <div class="signal-item"><span class="signal-value">持续更新</span><span class="signal-label">把下一次迭代写下来</span></div>
          </div>
        </section>

        <section id="work" class="section work-section">
          <div class="container">
            <div class="section-head-row">
              <div>
                <p class="section-label">01 / SELECTED WORK</p>
                <h2 class="section-title">项目不是结果图，<br /><em>而是一条解决问题的路径。</em></h2>
                <p class="section-intro">按类别筛选案例。每张卡片都通向一份完整拆解：问题、设计、架构、Bug 复盘和验证结果。</p>
              </div>
              <div class="category-switcher" aria-label="项目分类筛选">
                {categories.map((category, index) => <button class="category-filter" type="button" data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category === 'ALL' ? '全部' : category}</button>)}
              </div>
            </div>

            <div class="project-list">
              {projects.map((project, index) => (
                <article class="project-card" data-category={project.category}>
                  <a class={`project-media ${project.coverFit === 'contain' ? 'is-contain' : 'is-cover'}`} href={`/projects/${project.slug}/`} aria-label={`查看 ${project.title} 项目详情`}>
                    <img src={project.cover} alt={`${project.title} 项目预览`} loading={index === 0 ? 'eager' : 'lazy'} />
                  </a>
                  <div class="project-card-body">
                    <div class="project-card-meta"><span>0{index + 1}</span><span>{project.category}</span><span>{project.year}</span></div>
                    <h3 class="project-card-title">{project.title}</h3>
                    <p class="project-card-description">{project.description}</p>
                    <div class="tag-list">{project.tech.map((skill) => <span class="tag">{skill}</span>)}</div>
                    <div class="project-card-actions">
                      <a class="text-link" href={`/projects/${project.slug}/`}>阅读案例 <span>↗</span></a>
                      <a class="text-link" href={project.github} target="_blank" rel="noreferrer">源代码 <span>↗</span></a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section id="approach" class="section practice-section">
          <div class="container practice-grid">
            <div>
              <p class="section-label">02 / HOW I WORK</p>
              <h2 class="section-title">先理解问题，<br /><em>再决定技术。</em></h2>
              <p class="practice-copy">我更关心系统在失败、并发、重启和外部依赖不可用时会怎样。技术选型要服务于边界、反馈和长期维护，而不是单独成为项目卖点。</p>
            </div>
            <div class="practice-steps">
              {methodSteps.map((method, index) => <article class="practice-step"><span class="practice-step-number">0{index + 1}</span><div><h3>{method.title}</h3><p>{method.body}</p></div></article>)}
            </div>
          </div>
        </section>

        <section id="about" class="section about-section">
          <div class="container about-grid">
            <div>
              <p class="section-label">03 / ABOUT</p>
              <h2 class="section-title">把每个项目，<br /><em>做成可继续讨论的作品。</em></h2>
            </div>
            <div class="about-copy">
              <p>你好，我是 CRYBABY912，关注全栈工程、AI 应用和产品体验。这个页面记录的不只是“做过什么”，还包括为什么这样做、哪里出过问题，以及我用什么证据判断它已经足够好。</p>
              <div class="about-list">
                <div class="about-list-row"><span>Focus</span><strong>业务建模 / AI 工程 / 可靠性</strong></div>
                <div class="about-list-row"><span>Current</span><strong>把可视化 AI 工作流继续做成团队能力</strong></div>
                <div class="about-list-row"><span>Open source</span><strong>代码、测试和问题记录都在 GitHub</strong></div>
              </div>
              <a class="text-link" href="https://github.com/crybaby912" target="_blank" rel="noreferrer">访问 GitHub <span>↗</span></a>
            </div>
          </div>
        </section>
      </main>

      <footer class="site-footer"><span>© 2026 CRYBABY912</span><span>BUILT WITH ASTRO / DOCUMENTED WITH EVIDENCE</span><a href="#top">回到顶部 ↑</a></footer>
    </div>
  </body>
</html>

<script>
  const filters = [...document.querySelectorAll('[data-filter]')];
  const cards = [...document.querySelectorAll('[data-category]')];

  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const category = filter.getAttribute('data-filter');
      filters.forEach((item) => item.setAttribute('aria-pressed', String(item === filter)));
      cards.forEach((card) => {
        const matches = category === 'ALL' || card.getAttribute('data-category') === category;
        card.toggleAttribute('hidden', !matches);
      });
    });
  });

  const header = document.querySelector('.site-header');
  const menuToggle = document.querySelector('.menu-toggle');
  menuToggle?.addEventListener('click', () => {
    const isOpen = header?.classList.toggle('nav-open') ?? false;
    menuToggle.setAttribute('aria-expanded', String(isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? '关闭导航' : '打开导航');
  });
</script>
