---
import { featuredProject, projects } from '../data/projects';

const otherProjects = projects.slice(1);
const pageTitle = 'CRYBABY912 / 全栈与 AI 产品工程';
const pageDescription = 'CRYBABY912 的个人项目作品集，记录全栈系统、AI 应用和产品实践。';
const canonicalURL = new URL('/', Astro.site);
const socialImage = new URL(featuredProject.cover, Astro.site);
---

<html lang="zh-CN" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#111416" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body id="top">
    <a class="skip-link" href="#content">跳到主要内容</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="#top" aria-label="返回首页">
          <span class="brand-mark">C9</span>
          <span>CRYBABY912</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span>菜单</span>
          <span class="menu-icon">+</span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="主导航">
          <a href="#work">项目 <span>01</span></a>
          <a href="#approach">方法 <span>02</span></a>
          <a href="#about">关于 <span>03</span></a>
          <a class="nav-contact" href="https://github.com/crybaby912" target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
        </nav>
      </header>

      <main id="content">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-backdrop" aria-hidden="true"></div>
          <div class="hero-content">
            <p class="eyebrow"><span class="status-dot"></span> FULL-STACK / AI / PRODUCT ENGINEERING</p>
            <h1 id="hero-title">把复杂业务，<br /><em>做成能被使用的<wbr />产品。</em></h1>
            <div class="hero-bottom">
              <p class="hero-summary">我用代码拆解真实问题，构建从用户端到服务端都能跑起来的数字产品。</p>
              <a class="round-link" href="#work" aria-label="查看精选项目">↘</a>
            </div>
          </div>
          <div class="hero-index">SELECTED WORK / 2026</div>
        </section>

        <section class="signal-bar" aria-label="个人概览">
          <div><strong>01</strong><span>主项目</span></div>
          <div><strong>04</strong><span>运行端</span></div>
          <div><strong>AI</strong><span>产品能力</span></div>
          <div><strong>∞</strong><span>持续构建</span></div>
        </section>

        <section id="work" class="section work-section">
          <div class="section-heading reveal">
            <p class="section-kicker">01 / SELECTED WORK</p>
            <h2>正在把想法，<br /><span>推到真实场景里。</span></h2>
            <p class="section-intro">一个完整的产品，不止有漂亮的页面。它还要处理状态、数据、异常、性能和用户下一步要做什么。</p>
          </div>

          <div class="project-feature reveal" data-category={featuredProject.tech.join(' ').toLowerCase()}>
            <div class="project-copy">
              <div class="project-meta"><span>01</span><span>{featuredProject.eyebrow}</span><span>{featuredProject.year}</span></div>
              <h3>{featuredProject.title}</h3>
              <p class="project-lead">{featuredProject.description}</p>
              <div class="tag-list">
                {featuredProject.tech.map((skill) => <span>{skill}</span>)}
              </div>
              <div class="project-links">
                <a href={featuredProject.github} target="_blank" rel="noreferrer">查看源码 <span>↗</span></a>
                <a href={`/projects/${featuredProject.slug}/`}>项目拆解 <span>↗</span></a>
              </div>
            </div>
            <div class="project-visual" role="img" aria-label="食汇外卖项目的食材视觉和系统预览">
              <div class="visual-image"></div>
              <div class="app-window">
                <div class="window-bar"><span class="window-dot orange"></span><span class="window-dot yellow"></span><span class="window-dot green"></span><span class="window-title">merchant / overview</span></div>
                <div class="window-content">
                  <div class="window-sidebar"><b>食汇</b><span class="active">概览</span><span>订单</span><span>菜品</span><span>数据</span></div>
                  <div class="dashboard">
                    <div class="dashboard-top"><span>经营概览</span><small>DEMO DATA</small></div>
                    <div class="dashboard-numbers"><div><small>演示营业额</small><b>¥ 8,426</b></div><div><small>演示订单</small><b>286</b></div></div>
                    <div class="chart"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                    <div class="dashboard-footer"><span>交互效果示意</span><span>非真实经营数据</span></div>
                  </div>
                </div>
              </div>
              <div class="visual-note">USER → ORDER → DELIVERY</div>
            </div>
          </div>

          {otherProjects.length > 0 && (
            <div class="project-archive reveal" aria-label="更多项目">
              <p class="section-kicker">MORE PROJECTS</p>
              {otherProjects.map((project, index) => (
                <a class="archive-row" href={`/projects/${project.slug}/`}>
                  <span>0{index + 2}</span>
                  <strong>{project.title}</strong>
                  <small>{project.eyebrow} / {project.year}</small>
                  <b aria-hidden="true">↗</b>
                </a>
              ))}
            </div>
          )}
        </section>

        <section id="details" class="section details-section">
          <div class="section-heading reveal">
            <p class="section-kicker">02 / INSIDE THE BUILD</p>
            <h2>系统不是只有<br /><span>一个界面。</span></h2>
          </div>
          <div class="details-grid">
            <article class="detail-item reveal"><span class="detail-number">01</span><h3>从用户动作开始</h3><p>把点餐、选规格、结算、追踪订单拆成清晰的状态流，让每一步都有反馈。</p><a href={`/projects/${featuredProject.slug}/#key-decisions`}>用户端体验 <span>↗</span></a></article>
            <article class="detail-item reveal"><span class="detail-number">02</span><h3>让高并发有秩序</h3><p>用 Redis、Lua 和数据库约束处理秒杀库存，保证“卖完”不会变成超卖。</p><a href={`/projects/${featuredProject.slug}/#key-decisions`}>业务可靠性 <span>↗</span></a></article>
            <article class="detail-item reveal"><span class="detail-number">03</span><h3>把 AI 放在正确位置</h3><p>AI 客服连接真实订单、菜单和 FAQ，回答可以落到业务动作，而不是只会聊天。</p><a href={`/projects/${featuredProject.slug}/#key-decisions`}>AI 产品化 <span>↗</span></a></article>
          </div>
        </section>

        <section id="approach" class="section approach-section">
          <div class="approach-label reveal"><p class="section-kicker">03 / HOW I WORK</p><span>THE LOOP</span></div>
          <div class="approach-content reveal">
            <h2>先理解问题，<br />再决定技术。</h2>
            <p>我喜欢从用户路径、数据流和失败状态出发，把一个想法逐步收敛成可验证的产品。技术是手段，清楚的边界和可维护的结构才是长期价值。</p>
            <div class="loop"><span>DISCOVER</span><b>→</b><span>MODEL</span><b>→</b><span>BUILD</span><b>→</b><span>VERIFY</span></div>
          </div>
        </section>

        <section id="about" class="section about-section">
          <div class="about-title reveal"><p class="section-kicker">04 / ABOUT</p><h2>持续构建，<br /><span>持续靠近答案。</span></h2></div>
          <div class="about-copy reveal"><p>你好，我是 CRYBABY912。一名关注全栈工程、AI 应用和产品体验的开发者。目前正在把每一个项目都做成可以被理解、被运行、被继续迭代的作品。</p><a class="text-link" href="https://github.com/crybaby912" target="_blank" rel="noreferrer">github.com/crybaby912 <span>↗</span></a></div>
        </section>
      </main>

      <footer class="site-footer"><span>© 2026 CRYBABY912</span><span>BUILT WITH ASTRO / SHIPPED WITH CURIOSITY</span><a href="#top">回到顶部 ↑</a></footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; background: #111416; }
  :global(body) { margin: 0; color: #f1eee6; background: #111416; font-family: Arial, "Microsoft YaHei", sans-serif; font-size: 16px; line-height: 1.6; overflow-x: hidden; }
  :global(a) { color: inherit; text-decoration: none; }
  .skip-link { background: #9ce7c3; color: #111416; font-size: 13px; left: 18px; padding: 9px 13px; position: fixed; top: 12px; transform: translateY(-150%); transition: transform .2s ease; z-index: 20; }
  .skip-link:focus { transform: translateY(0); }
  .site-shell { overflow-x: clip; }
  .site-header { align-items: center; display: flex; height: 80px; justify-content: space-between; left: 0; padding: 0 clamp(24px, 5vw, 80px); position: fixed; right: 0; top: 0; transition: background-color .25s ease, border-color .25s ease; z-index: 10; }
  .site-header.is-scrolled, .site-header.menu-open { backdrop-filter: blur(16px); background: rgba(17,20,22,.93); border-bottom: 1px solid rgba(241,238,230,.12); }
  .brand { align-items: center; display: flex; font-size: 13px; font-weight: 700; gap: 11px; letter-spacing: .16em; }
  .brand-mark { align-items: center; border: 1px solid rgba(241,238,230,.8); border-radius: 50%; display: inline-flex; font-size: 11px; height: 30px; justify-content: center; letter-spacing: 0; width: 30px; }
  .site-nav { align-items: center; display: flex; gap: clamp(18px, 3vw, 42px); }
  .site-nav a { color: rgba(241,238,230,.72); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; transition: color .25s ease; }
  a:focus-visible, button:focus-visible { outline: 2px solid #9ce7c3; outline-offset: 5px; }
  .site-nav a:hover { color: #f7a779; }
  .site-nav span { color: rgba(241,238,230,.35); font-size: 10px; margin-left: 4px; }
  .site-nav .nav-contact { border-bottom: 1px solid #f7a779; color: #f7a779; padding-bottom: 4px; }
  .menu-toggle { background: none; border: 0; color: #f1eee6; display: none; font: inherit; }
  .menu-icon { font-size: 24px; line-height: 12px; margin-left: 8px; transition: transform .2s ease; }
  .menu-toggle[aria-expanded="true"] .menu-icon { transform: rotate(45deg); }
  .hero { align-items: flex-end; display: flex; min-height: min(860px, 92vh); overflow: hidden; padding: 150px clamp(24px, 8vw, 132px) 78px; position: relative; }
  .hero-backdrop { background-color: #24221e; background-image: url('/food-hero.jpg'); background-position: center; background-size: cover; inset: 0; opacity: .48; position: absolute; }
  .hero-backdrop::after { background: rgba(17,20,22,.56); content: ''; inset: 0; position: absolute; }
  .hero-content, .hero-index { position: relative; z-index: 1; }
  .hero-content { max-width: 1120px; width: 100%; }
  .eyebrow, .section-kicker { color: #f7a779; font-size: 11px; font-weight: 700; letter-spacing: .16em; margin: 0 0 28px; text-transform: uppercase; }
  .status-dot { background: #9ce7c3; border-radius: 50%; box-shadow: 0 0 0 5px rgba(156,231,195,.12); display: inline-block; height: 7px; margin-right: 10px; width: 7px; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { font-size: 100px; font-weight: 700; letter-spacing: 0; line-height: .98; margin-bottom: 48px; max-width: 1120px; overflow-wrap: anywhere; }
  h1 em, h2 span { color: #f7a779; font-style: normal; }
  .hero-bottom { align-items: flex-end; display: flex; justify-content: space-between; max-width: 790px; }
  .hero-summary { color: rgba(241,238,230,.78); font-size: 17px; line-height: 1.7; margin-bottom: 0; max-width: 420px; }
  .round-link { align-items: center; border: 1px solid rgba(241,238,230,.6); border-radius: 50%; display: flex; font-size: 27px; height: 64px; justify-content: center; transition: background .25s ease, color .25s ease; width: 64px; }
  .round-link:hover { background: #f7a779; color: #111416; }
  .hero-index { bottom: 86px; color: rgba(241,238,230,.6); font-size: 10px; letter-spacing: .17em; position: absolute; right: clamp(24px, 5vw, 80px); writing-mode: vertical-rl; }
  .signal-bar { border-bottom: 1px solid rgba(241,238,230,.16); border-top: 1px solid rgba(241,238,230,.16); display: grid; grid-template-columns: repeat(4, 1fr); padding: 24px clamp(24px, 8vw, 132px); }
  .signal-bar div { align-items: baseline; display: flex; gap: 13px; }
  .signal-bar strong { color: #f7a779; font-size: 24px; font-weight: 400; }
  .signal-bar span { color: rgba(241,238,230,.53); font-size: 11px; letter-spacing: .13em; text-transform: uppercase; }
  .section { padding: 145px clamp(24px, 8vw, 132px); }
  .section-heading { display: grid; grid-template-columns: 1fr 1.3fr .75fr; gap: 30px; margin-bottom: 75px; }
  .section-heading h2, .about-title h2 { font-size: 72px; font-weight: 500; letter-spacing: 0; line-height: 1.04; margin: 0; }
  .section-intro { color: rgba(241,238,230,.55); font-size: 15px; line-height: 1.8; margin: 8px 0 0; max-width: 275px; }
  .project-feature { background: #1b2021; display: grid; grid-template-columns: .8fr 1.2fr; min-height: 630px; }
  .project-copy { display: flex; flex-direction: column; padding: clamp(28px, 4vw, 64px); }
  .project-meta { color: rgba(241,238,230,.4); display: flex; font-size: 10px; gap: 18px; letter-spacing: .14em; }
  .project-meta span:first-child { color: #f7a779; }
  .project-copy h3 { font-size: 68px; font-weight: 500; letter-spacing: 0; line-height: 1; margin: 85px 0 22px; }
  .project-lead { color: rgba(241,238,230,.68); font-size: 16px; line-height: 1.8; max-width: 390px; }
  .tag-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .tag-list span { border: 1px solid rgba(241,238,230,.2); color: rgba(241,238,230,.66); font-size: 11px; padding: 6px 10px; }
  .project-links { display: flex; gap: 25px; margin-top: auto; padding-top: 55px; }
  .project-links a, .detail-item a, .text-link { border-bottom: 1px solid #f7a779; color: #f7a779; font-size: 12px; letter-spacing: .08em; padding-bottom: 4px; }
  .project-links span, .detail-item a span, .text-link span { margin-left: 7px; }
  .project-visual { background: #ce754d; min-height: 600px; overflow: hidden; position: relative; }
  .visual-image { background: url('/food-hero.jpg') center / cover; inset: 0; opacity: .35; position: absolute; }
  .app-window { background: rgba(247,243,232,.92); box-shadow: 0 25px 50px rgba(0,0,0,.28); color: #242928; left: 12%; position: absolute; right: 9%; top: 15%; transform: rotate(-3deg); }
  .window-bar { align-items: center; background: #2c3433; color: #dfe5dc; display: flex; gap: 6px; height: 28px; padding: 0 12px; }
  .window-dot { border-radius: 50%; height: 6px; width: 6px; }.orange { background: #f07f51; }.yellow { background: #e9c86d; }.green { background: #9ce7c3; }.window-title { font-size: 8px; letter-spacing: .1em; margin-left: 7px; opacity: .7; }
  .window-content { display: flex; min-height: 330px; }
  .window-sidebar { background: #323a38; color: #dfe5dc; display: flex; flex: 0 0 22%; flex-direction: column; gap: 24px; padding: 24px 15px; }.window-sidebar b { color: #f7a779; font-size: 16px; margin-bottom: 12px; }.window-sidebar span { font-size: 10px; opacity: .52; }.window-sidebar .active { color: #fff; opacity: 1; }
  .dashboard { flex: 1; padding: 34px 28px; }.dashboard-top { display: flex; font-size: 16px; justify-content: space-between; }.dashboard-top small { color: #55a47b; font-size: 9px; }.dashboard-numbers { display: flex; gap: 45px; margin-top: 40px; }.dashboard-numbers div { display: flex; flex-direction: column; gap: 8px; }.dashboard-numbers small { color: #737d77; font-size: 9px; }.dashboard-numbers b { font-size: 28px; font-weight: 500; }.chart { align-items: flex-end; border-bottom: 1px solid #d7d9d1; display: flex; gap: 7%; height: 100px; margin-top: 36px; padding: 0 10px; }.chart i { background: #e08a63; display: block; flex: 1; height: 35%; }.chart i:nth-child(2) { height: 58%; }.chart i:nth-child(3) { height: 46%; }.chart i:nth-child(4) { height: 75%; }.chart i:nth-child(5) { height: 64%; }.chart i:nth-child(6) { height: 89%; }.chart i:nth-child(7) { height: 71%; }.chart i:nth-child(8) { height: 96%; }.dashboard-footer { color: #737d77; display: flex; font-size: 10px; justify-content: space-between; margin-top: 13px; }.dashboard-footer span:last-child { color: #55a47b; }
  .visual-note { bottom: 24px; color: rgba(255,255,255,.78); font-size: 10px; letter-spacing: .16em; position: absolute; right: 27px; }
  .project-archive { border-top: 1px solid rgba(241,238,230,.18); margin-top: 70px; padding-top: 24px; }
  .archive-row { align-items: center; border-bottom: 1px solid rgba(241,238,230,.18); display: grid; gap: 24px; grid-template-columns: 40px 1fr auto 24px; padding: 24px 0; transition: color .2s ease, padding .2s ease; }
  .archive-row:hover { color: #f7a779; padding-left: 8px; }
  .archive-row > span, .archive-row small { color: rgba(241,238,230,.45); font-size: 11px; }
  .archive-row strong { font-size: 24px; font-weight: 500; }
  .archive-row b { color: #f7a779; font-weight: 400; }
  .details-section { background: #e8e4d9; color: #202624; }.details-section .section-kicker { color: #b94f36; }.details-section h2 span { color: #b94f36; }.details-grid { border-top: 1px solid rgba(32,38,36,.24); display: grid; grid-template-columns: repeat(3, 1fr); }.detail-item { border-right: 1px solid rgba(32,38,36,.24); min-height: 300px; padding: 28px 30px 25px 0; }.detail-item:not(:first-child) { padding-left: 30px; }.detail-item:last-child { border-right: 0; }.detail-number { color: #b94f36; font-size: 12px; }.detail-item h3 { font-size: 26px; font-weight: 500; letter-spacing: -.04em; margin: 60px 0 15px; }.detail-item p { color: rgba(32,38,36,.64); font-size: 14px; line-height: 1.8; max-width: 280px; }.detail-item a { border-color: #b94f36; color: #b94f36; display: inline-block; margin-top: 20px; }
  .approach-section { display: grid; gap: 30px; grid-template-columns: 1fr 1.3fr; }.approach-label span { color: rgba(241,238,230,.34); font-size: 10px; letter-spacing: .2em; }.approach-content h2 { font-size: 78px; font-weight: 500; letter-spacing: 0; line-height: .98; margin-bottom: 36px; }.approach-content p { color: rgba(241,238,230,.6); font-size: 17px; line-height: 1.8; max-width: 490px; }.loop { align-items: center; border-top: 1px solid rgba(241,238,230,.2); display: flex; gap: clamp(10px, 2vw, 30px); margin-top: 75px; padding-top: 18px; }.loop span { color: #f7a779; font-size: 11px; letter-spacing: .12em; }.loop b { color: rgba(241,238,230,.3); font-weight: 400; }
  .about-section { background: #f7a779; color: #202624; display: grid; gap: 30px; grid-template-columns: 1.3fr 1fr; }.about-section .section-kicker { color: #202624; }.about-title h2 span { color: #f7eee3; }.about-copy { align-self: end; max-width: 430px; }.about-copy p { font-size: 18px; line-height: 1.75; }.text-link { border-color: #202624; color: #202624; display: inline-block; margin-top: 30px; }
  .site-footer { align-items: center; color: rgba(241,238,230,.42); display: flex; font-size: 10px; justify-content: space-between; letter-spacing: .12em; padding: 25px clamp(24px, 5vw, 80px); }.site-footer a { color: #f7a779; }
  .reveal { opacity: 1; transform: none; }
  :global(.js) .reveal { opacity: 0; transform: translateY(25px); transition: opacity .7s ease, transform .7s ease; }
  :global(.js) .reveal.is-visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; }:global(.js) .reveal { opacity: 1; transform: none; transition: none; } }
  @media (max-width: 1200px) { h1 { font-size: 82px; }.section-heading h2, .about-title h2 { font-size: 60px; }.approach-content h2 { font-size: 66px; } }
