---
import { projects } from '../../data/projects';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CasePanel from '../../components/CasePanel.astro';
import '../../styles/site.css';
import '../../styles/motion.css';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const screenshots = project.screenshots ?? [];
const caseSections = [
  { id: 'problem', label: '概览' },
  { id: 'architecture', label: '架构' },
  { id: 'incidents', label: '复盘' },
  { id: 'evidence', label: '证据' },
  ...(screenshots.length ? [{ id: 'showcase', label: '界面' }] : []),
];
const screenshotGroupLabels = {
  user: '用户端',
  admin: '商家端',
  platform: '平台端',
};
const screenshotFilterGroups = [...new Set(screenshots.map((shot) => shot.group))];
const screenshotSections = (
  project.screenshotSections ?? [
    {
      key: 'desktop',
      eyebrow: '01 / 桌面端界面',
      title: '商家经营工作台',
      body: '把订单、优惠、评价和客服放在同一套宽屏工作流里，重点看信息层级与业务状态。',
    },
    {
      key: 'mobile',
      eyebrow: '02 / 移动端界面',
      title: '用户点餐与服务流程',
      body: '按真实使用顺序整理首页、菜品、地址、订单和客服，保持每张手机界面有稳定的阅读尺寸。',
    },
  ]
).map((section) => ({
  ...section,
  items: screenshots.filter((shot) => shot.kind === section.key),
})).filter((section) => section.items.length);
const pageTitle = project.title + ' / CRYBABY912';
const pageDescription = project.title + ' 项目案例：' + project.description;
const canonicalURL = new URL('/projects/' + project.slug + '/', Astro.site);
const socialImage = new URL(project.cover, Astro.site);
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#f4f5f1" />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body id="top">
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <a class="skip-link" href="#content">跳到主要内容</a>
    <div class="site-shell detail-shell">
      <SiteHeader detail caseSections={caseSections} />

      <main id="content">
        <section class="detail-hero">
          <div class="container detail-hero-grid">
            <div class="detail-hero-copy" data-detail-reveal>
              <p class="eyebrow">{project.category} / {project.year}</p>
              <h1 class="detail-title">{project.title}</h1>
              <p class="detail-lead">{project.summary}</p>
              <dl class="detail-meta">
                <div><dt>项目状态</dt><dd>{project.status}</dd></div>
                <div><dt>我的角色</dt><dd>{project.role}</dd></div>
                <div><dt>运行端</dt><dd>{project.platforms.length} 个端 / 服务</dd></div>
              </dl>
              <div class="hero-actions">
                <a class="button button-primary" href={project.github} target="_blank" rel="noreferrer">查看源代码 <span aria-hidden="true">↗</span></a>
                <a class="button button-quiet" href="#incidents">直接看 Bug 复盘 <span aria-hidden="true">↓</span></a>
              </div>
            </div>
            <figure class={'detail-media ' + (project.coverFit === 'contain' ? 'is-contain' : 'is-cover')} data-detail-reveal data-aperture>
              <img src={project.cover} alt={project.title + ' 项目演示'} loading="eager" />
              <figcaption class="media-caption">{project.title} / 真实项目界面</figcaption>
            </figure>
          </div>
        </section>

        <section class="detail-metrics" aria-label="项目结果">
          <div class="container metric-grid">
            {project.metrics.map((metric) => <div class="metric-card" data-detail-reveal><span class="metric-value">{metric.value}</span><span class="metric-label">{metric.label}</span><span class="metric-note">{metric.note}</span></div>)}
          </div>
        </section>

        <section id="problem" class="detail-section" data-section>
          <div class="container section-split">
            <div data-detail-reveal><p class="section-label">01 / 问题定义</p><h2 class="section-title">{project.problem.title}</h2></div>
            <div data-detail-reveal><p class="problem-body">{project.problem.body}</p><ul class="constraint-list">{project.problem.constraints.map((constraint) => <li>{constraint}</li>)}</ul></div>
          </div>
        </section>

        <section class="detail-section">
          <div class="container section-split">
            <div data-detail-reveal><p class="section-label">02 / 实现路径</p><h2 class="section-title">功能如何落到<br /><em>可运行的系统里。</em></h2></div>
            <div class="case-stack" data-case-group="workflow">
              {project.workflow.map((step) => <CasePanel eyebrow={step.step + ' / 实现步骤'} title={step.title} body={step.body} tags={step.artifact.split(' / ')} />)}
            </div>
          </div>
        </section>

        <section id="architecture" class="detail-section" data-section>
          <div class="container section-split">
            <div data-detail-reveal><p class="section-label">03 / 系统分层</p><h2 class="section-title">每一层都有<br /><em>自己的边界。</em></h2></div>
            <div class="case-stack" data-case-group="architecture">
              {project.architecture.map((layer) => <CasePanel eyebrow={layer.layer} title={layer.title} body={layer.body} tags={layer.tags} />)}
            </div>
          </div>
        </section>

        <section class="detail-section">
          <div class="container section-split">
            <div data-detail-reveal><p class="section-label">04 / 关键取舍</p><h2 class="section-title">不是堆技术，<br /><em>而是明确取舍。</em></h2></div>
            <div class="case-stack" data-case-group="decisions">
              {project.decisions.map((decision, index) => (
                <CasePanel eyebrow={'取舍 0' + (index + 1)} title={decision.title}>
                  <dl class="case-fields"><div><dt>问题</dt><dd>{decision.problem}</dd></div><div><dt>决定</dt><dd>{decision.decision}</dd></div><div><dt>结果</dt><dd>{decision.result}</dd></div></dl>
                </CasePanel>
              ))}
            </div>
          </div>
        </section>

        <section id="incidents" class="detail-section incident-section" data-section>
          <div class="container">
            <p class="section-label" data-detail-reveal>05 / 故障复盘</p>
            <h2 class="section-title" data-detail-reveal>真正有含金量的，<br /><em>通常是出问题之后。</em></h2>
            <p class="section-copy" data-detail-reveal>下面挑选的是会改变系统设计的故障，而不是纯粹的文案或样式调整。每条记录都保留现象、根因、修复和最终留下的工程判断。</p>
            <div class="incident-grid">
              {project.incidents.slice(0, 4).map((incident, index) => (
                <CasePanel eyebrow={'复盘 0' + (index + 1)} title={incident.title}>
                  <dl class="case-fields"><div><dt>现象</dt><dd>{incident.symptom}</dd></div><div><dt>根因</dt><dd>{incident.rootCause}</dd></div><div><dt>修复</dt><dd>{incident.fix}</dd></div></dl>
                  <p class="case-note">{incident.lesson}</p>
                </CasePanel>
              ))}
            </div>
            {project.incidents.length > 4 ? (
              <details class="incident-more" data-detail-reveal>
                <summary><span>补充复盘 · {project.incidents.length - 4} 条</span><span data-expand-label>展开查看</span><span data-collapse-label>收起内容</span></summary>
                <div class="incident-more-grid">
                  {project.incidents.slice(4).map((incident, index) => (
                    <CasePanel eyebrow={'补充 0' + (index + 1)} title={incident.title}>
                      <dl class="case-fields"><div><dt>现象</dt><dd>{incident.symptom}</dd></div><div><dt>根因</dt><dd>{incident.rootCause}</dd></div><div><dt>修复</dt><dd>{incident.fix}</dd></div></dl>
                      <p class="case-note">{incident.lesson}</p>
                    </CasePanel>
                  ))}
                </div>
              </details>
            ) : null}
          </div>
        </section>

        <section id="evidence" class="detail-section evidence-section" data-section>
          <div class="container section-split">
            <div data-detail-reveal><p class="section-label">06 / 验证证据</p><h2 class="section-title">让结果可以被<br /><em>别人复核。</em></h2></div>
            <div>
              <p class="section-copy" data-detail-reveal>数字只在边界清楚时才有意义。这里标注测试环境、验收范围和仍然没有宣称完成的部分。</p>
              <div class="evidence-grid">{project.evidence.map((item) => <article class="evidence-card" data-detail-reveal><span class="evidence-value">{item.value}</span><strong>{item.label}</strong><p>{item.detail}</p></article>)}</div>
              <div class="next-list">{project.nextSteps.map((nextStep, index) => <div class="next-item"><span>下一步 0{index + 1}</span><p>{nextStep}</p></div>)}</div>
            </div>
          </div>
        </section>

        {screenshots.length ? (
          <section id="showcase" class="detail-section showcase-section" data-section>
            <div class="container">
              <div class="showcase-header" data-detail-reveal>
                <div>
                  <p class="section-label">07 / 界面展示</p>
                  <h2 class="section-title">真实界面，<br /><em>让业务链路可见。</em></h2>
                </div>
                <div class="showcase-intro">
                  <p class="section-copy">{project.screenshotIntro ?? '这里选取项目的关键界面，按真实使用路径整理。点击任意界面可以查看完整截图。'}</p>
                  <div class="showcase-switcher" role="group" aria-label="界面筛选">
                    <button type="button" class="showcase-filter is-active" data-gallery-filter="all" aria-pressed="true">全部</button>
                    {screenshotFilterGroups.map((group) => <button type="button" class="showcase-filter" data-gallery-filter={group} aria-pressed="false">{screenshotGroupLabels[group]}</button>)}
                  </div>
                  <p class="showcase-count" data-gallery-count aria-live="polite">共 {screenshots.length} 个界面</p>
                </div>
              </div>
              <div class="showcase-groups">
                {screenshotSections.map((group) => (
                  <section class={'showcase-group showcase-group-' + group.key} data-gallery-section={group.key}>
                    <div class="showcase-group-heading" data-detail-reveal>
                      <div>
                        <p class="showcase-group-eyebrow">{group.eyebrow}</p>
                        <h3>{group.title}</h3>
                      </div>
                      <p>{group.body}</p>
                    </div>
                    <div class="showcase-grid">
                      {group.items.map((shot) => {
                        const index = screenshots.indexOf(shot);
                        return (
                          <a href={shot.src} target="_blank" rel="noreferrer" class={'showcase-item ' + (shot.kind === 'desktop' ? 'is-desktop' : 'is-mobile')} data-detail-reveal data-gallery-item data-gallery-group={shot.group} data-gallery-index={index} data-gallery-src={shot.src} data-gallery-poster={shot.poster} data-gallery-title={shot.title} data-gallery-caption={shot.caption} aria-label={'打开 ' + shot.title + ' 详情'}>
                            <span class="showcase-item-top"><span>{screenshotGroupLabels[shot.group]}</span><span>{shot.poster ? '演示 · 手动播放' : shot.kind === 'mobile' ? '移动端' : '桌面端'}</span></span>
                            <span class="showcase-image"><img src={shot.poster ?? shot.src} alt={project.title + ' - ' + shot.title} loading="lazy" decoding="async" /></span>
                            <span class="showcase-item-copy"><strong>{shot.title}</strong><small>{shot.caption}</small></span>
                            <span class="showcase-open" aria-hidden="true">↗</span>
                          </a>
                        );
                      })}
                    </div>
                  </section>
                ))}
              </div>
            </div>
          </section>
        ) : null}

        {screenshots.length ? (
          <dialog class="lightbox" data-lightbox aria-labelledby="lightbox-title">
            <div class="lightbox-frame">
              <div class="lightbox-topline">
                <p id="lightbox-title">界面详情</p>
                <button class="lightbox-close" type="button" data-lightbox-close aria-label="关闭预览" title="关闭预览">×</button>
              </div>
              <figure class="lightbox-figure">
                <p class="lightbox-status" data-lightbox-status role="status" hidden></p>
                <img data-lightbox-image alt="" hidden />
                <figcaption data-lightbox-caption></figcaption>
              </figure>
              <div class="lightbox-footer">
                <span data-lightbox-counter aria-live="polite">01 / 01</span>
                <div class="lightbox-actions">
                  <button class="lightbox-play" type="button" data-lightbox-play hidden aria-pressed="false">播放演示</button>
                  <a class="lightbox-original" data-lightbox-original target="_blank" rel="noreferrer">打开原图 ↗</a>
                  <button class="lightbox-arrow" type="button" data-lightbox-prev aria-label="上一张" title="上一张">←</button>
                  <button class="lightbox-arrow" type="button" data-lightbox-next aria-label="下一张" title="下一张">→</button>
                </div>
              </div>
            </div>
          </dialog>
        ) : null}

        <section class="detail-cta">
          <div class="container detail-cta-grid">
            <div data-detail-reveal><p class="section-label">代码 / 下一次迭代</p><h2>看完实现路径，<br /><em>再回到代码里验证。</em></h2></div>
            <a class="button button-quiet" href={project.github} target="_blank" rel="noreferrer">打开 GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </section>
      </main>

      <SiteFooter note={project.title + ' / 项目案例'} />
    </div>
  </body>
</html>

<script>
  import '../../scripts/gallery';
</script>
