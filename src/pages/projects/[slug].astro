---
import { projects } from '../../data/projects';
import '../../styles/site.css';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const pageTitle = `${project.title} / CRYBABY912`;
const pageDescription = `${project.title} 项目案例：${project.description}`;
const canonicalURL = new URL(`/projects/${project.slug}/`, Astro.site);
const socialImage = new URL(project.cover, Astro.site);
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#f5f2ea" />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#content">跳到主要内容</a>
    <div class="site-shell detail-shell">
      <header class="detail-top">
        <div class="container">
          <a class="brand" href="/" aria-label="返回作品集首页"><span class="brand-mark">C9</span><span>CRYBABY912</span></a>
          <a class="back-link" href="/">← 返回全部项目</a>
        </div>
      </header>

      <main id="content">
        <section class="detail-hero">
          <div class="container detail-hero-grid">
            <div>
              <p class="eyebrow">{project.category} / {project.year}</p>
              <h1 class="detail-title">{project.title}</h1>
              <p class="detail-lead">{project.summary}</p>
              <dl class="detail-meta">
                <div><dt>项目状态</dt><dd>{project.status}</dd></div>
                <div><dt>我的角色</dt><dd>{project.role}</dd></div>
                <div><dt>运行端</dt><dd>{project.platforms.length} 个端 / 服务</dd></div>
              </dl>
              <div class="hero-actions"><a class="button button-primary" href={project.github} target="_blank" rel="noreferrer">查看源代码 <span>↗</span></a><a class="button button-quiet" href="#incidents">直接看 Bug 复盘 <span>↓</span></a></div>
            </div>
            <figure class={`detail-media ${project.coverFit === 'contain' ? 'is-contain' : 'is-cover'}`}>
              <span class="media-caption">VISUAL / PROJECT PREVIEW</span>
              <img src={project.cover} alt={`${project.title} 项目演示`} loading="eager" />
            </figure>
          </div>
        </section>

        <section class="detail-metrics" aria-label="项目结果">
          <div class="container metric-grid">
            {project.metrics.map((metric) => <div class="metric-card"><span class="metric-value">{metric.value}</span><span class="metric-label">{metric.label}</span><span class="metric-note">{metric.note}</span></div>)}
          </div>
        </section>

        <section class="detail-section">
          <div class="container section-split">
            <div><p class="section-label">01 / THE PROBLEM</p><h2 class="section-title">{project.problem.title}</h2></div>
            <div><p class="problem-body">{project.problem.body}</p><ul class="constraint-list">{project.problem.constraints.map((constraint) => <li>{constraint}</li>)}</ul></div>
          </div>
        </section>

        <section class="detail-section alt">
          <div class="container section-split">
            <div><p class="section-label">02 / BUILD PATH</p><h2 class="section-title">功能如何落到<br /><em>可运行的系统里。</em></h2></div>
            <div class="workflow-grid">
              {project.workflow.map((step) => <article class="workflow-card"><span class="workflow-step">{step.step}</span><h3>{step.title}</h3><p>{step.body}</p><div class="workflow-artifact">{step.artifact}</div></article>)}
            </div>
          </div>
        </section>

        <section class="detail-section">
          <div class="container section-split">
            <div><p class="section-label">03 / SYSTEM MAP</p><h2 class="section-title">每一层都有<br /><em>自己的边界。</em></h2></div>
            <div class="architecture-list">
              {project.architecture.map((layer) => <article class="architecture-row"><div class="architecture-layer">{layer.layer}</div><div><h3>{layer.title}</h3><p>{layer.body}</p></div><div class="architecture-tags">{layer.tags.map((tag) => <span>{tag}</span>)}</div></article>)}
            </div>
          </div>
        </section>

        <section class="detail-section alt">
          <div class="container section-split">
            <div><p class="section-label">04 / KEY DECISIONS</p><h2 class="section-title">不是堆技术，<br /><em>而是明确取舍。</em></h2></div>
            <div class="decision-list">
              {project.decisions.map((decision) => <article class="decision-card"><h3>{decision.title}</h3><dl class="decision-field"><dt>问题</dt><dd>{decision.problem}</dd></dl><dl class="decision-field"><dt>决定</dt><dd>{decision.decision}</dd></dl><dl class="decision-field"><dt>结果</dt><dd>{decision.result}</dd></dl></article>)}
            </div>
          </div>
        </section>

        <section id="incidents" class="detail-section incident-section">
          <div class="container">
            <p class="section-label">05 / INCIDENT NOTES</p>
            <h2 class="section-title">真正有含金量的，<br /><em>通常是出问题之后。</em></h2>
            <p class="section-copy">下面挑选的是会改变系统设计的故障，而不是纯粹的文案或样式调整。每条记录都保留现象、根因、修复和最终留下的工程判断。</p>
            <div class="incident-grid">
              {project.incidents.map((incident, index) => <article class="incident-card"><span class="incident-number">BUG 0{index + 1}</span><h3>{incident.title}</h3><dl class="incident-field"><dt>现象</dt><dd>{incident.symptom}</dd></dl><dl class="incident-field"><dt>根因</dt><dd>{incident.rootCause}</dd></dl><dl class="incident-field"><dt>修复</dt><dd>{incident.fix}</dd></dl><p class="incident-lesson">{incident.lesson}</p></article>)}
            </div>
          </div>
        </section>

        <section class="detail-section evidence-section">
          <div class="container section-split">
            <div><p class="section-label">06 / EVIDENCE</p><h2 class="section-title">让结果可以被<br /><em>别人复核。</em></h2></div>
            <div>
              <p class="section-copy">数字只在边界清楚时才有意义。这里标注测试环境、验收范围和仍然没有宣称完成的部分。</p>
              <div class="evidence-grid">{project.evidence.map((item) => <article class="evidence-card"><span class="evidence-value">{item.value}</span><strong>{item.label}</strong><p>{item.detail}</p></article>)}</div>
              <div class="next-list">{project.nextSteps.map((nextStep, index) => <div class="next-item"><span>NEXT 0{index + 1}</span><p>{nextStep}</p></div>)}</div>
            </div>
          </div>
        </section>

        <section class="detail-cta">
          <div class="container detail-cta-grid">
            <div><p class="section-label">SOURCE / NEXT ITERATION</p><h2>看完实现路径，<br /><em>再回到代码里验证。</em></h2></div>
            <a class="button button-quiet" href={project.github} target="_blank" rel="noreferrer">打开 GitHub <span>↗</span></a>
          </div>
        </section>
      </main>

      <footer class="detail-footer"><span>© 2026 CRYBABY912</span><span>{project.title} / CASE STUDY</span><a href="#top">回到顶部 ↑</a></footer>
    </div>
  </body>
</html>
