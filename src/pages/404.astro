---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeHead from '../components/ThemeHead.astro';
import '../styles/site.css';
import '../styles/motion.css';
import '../styles/theme.css';
const pageTitle = '页面未找到 / CRYBABY912';
---
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <ThemeHead />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#content">跳到主要内容</a>
    <div class="site-shell">
      <SiteHeader detail />
      <main id="content" class="container error-page">
        <p class="error-index" aria-hidden="true" data-reveal>404</p>
        <div class="error-copy">
          <p class="eyebrow" data-reveal>这个地址暂时没有内容</p>
          <h1 class="section-title" data-reveal>页面没有找到，<br /><em>项目还在这里。</em></h1>
          <p class="section-copy" data-reveal>链接可能已更新。可以回到作品集，继续查看项目、系统设计和故障复盘。</p>
          <div class="hero-actions" data-reveal>
            <a class="button button-primary" href="/#work">查看全部项目 <span aria-hidden="true">↗</span></a>
            <a class="button button-quiet" href="/">回到首页</a>
          </div>
        </div>
      </main>
      <SiteFooter note="页面未找到 · 404" showBackToTop={false} />
    </div>
  </body>
</html>
<style>
  .error-page { display: grid; grid-template-columns: .8fr 1.2fr; align-items: center; gap: 72px; min-height: calc(100dvh - 160px); padding-block: 80px; }
  .error-index { margin: 0; color: var(--teal); font-size: clamp(120px, 20vw, 260px); font-weight: 750; letter-spacing: -.08em; line-height: 1; }
  .error-copy { max-width: 640px; }
  @media (max-width: 680px) {
    .error-page { grid-template-columns: 1fr; gap: 36px; padding-block: 60px; }
    .error-index { font-size: 130px; }
  }
</style>
