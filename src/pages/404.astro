---
const pageTitle = '页面未找到 / CRYBABY912';
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#111416" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main>
      <header>
        <a class="brand" href="/" aria-label="返回首页"><span>C9</span><b>CRYBABY912</b></a>
        <small>ERROR / 404</small>
      </header>
      <section>
        <p>THIS ROUTE ENDS HERE</p>
        <h1>这里没有页面，<br /><em>但还有作品<span class="mobile-line">可以看。</span></em></h1>
        <a class="home-link" href="/">返回作品集 <span>↗</span></a>
      </section>
      <footer><span>404 / NOT FOUND</span><span>KEEP EXPLORING</span></footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { background: #111416; color: #f1eee6; font-family: Arial, "Microsoft YaHei", sans-serif; margin: 0; }
  :global(a) { color: inherit; text-decoration: none; }
  main { display: flex; flex-direction: column; min-height: 100vh; padding: 0 clamp(24px, 8vw, 132px); }
  header, footer { align-items: center; display: flex; height: 80px; justify-content: space-between; }
  .brand { align-items: center; display: flex; font-size: 13px; gap: 11px; }.brand span { align-items: center; border: 1px solid rgba(241,238,230,.8); border-radius: 50%; display: flex; font-size: 11px; height: 30px; justify-content: center; width: 30px; }.brand b { font-weight: 700; }
  header small, footer { color: rgba(241,238,230,.42); font-size: 10px; }
  section { margin: auto 0; padding: 70px 0; }
  section > p { color: #9ce7c3; font-size: 11px; font-weight: 700; margin: 0 0 28px; }
  h1 { font-size: 86px; font-weight: 500; letter-spacing: 0; line-height: 1; margin: 0 0 50px; max-width: 1000px; overflow-wrap: anywhere; }
  h1 em { color: #f7a779; font-style: normal; }
  .mobile-line { display: inline; }
  .home-link { border-bottom: 1px solid #f7a779; color: #f7a779; display: inline-block; font-size: 13px; padding-bottom: 5px; }.home-link span { margin-left: 7px; }
  footer { border-top: 1px solid rgba(241,238,230,.16); }
  a:focus-visible { outline: 2px solid #9ce7c3; outline-offset: 5px; }
  @media (max-width: 800px) { header { height: 68px; }.brand { font-size: 11px; }header small { display: none; }h1 { font-size: 42px; max-width: 310px; overflow-wrap: anywhere; word-break: normal; }.mobile-line { display: block; }footer { align-items: flex-start; flex-direction: column; height: auto; gap: 10px; padding: 22px 0; } }
</style>
