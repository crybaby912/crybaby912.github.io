---
interface Props {
  detail?: boolean;
  caseSections?: { id: string; label: string }[];
}
const { detail = false, caseSections = [] } = Astro.props;
const hasCaseNav = detail && caseSections.length > 0;
---
<header class:list={['site-header', { 'is-detail': detail, 'has-case-nav': hasCaseNav }]}>
  <div class="container">
    <a class="brand" href={detail ? '/' : '#top'} aria-label="返回作品集首页"><span class="brand-mark">C9</span><span>CRYBABY912</span></a>
    {hasCaseNav && (
      <nav id="case-nav" class="case-nav" aria-label="案例章节">
        {caseSections.map((section, index) => <a href={'#' + section.id} data-nav-link aria-current={index === 0 ? 'location' : undefined}><span>0{index + 1}</span>{section.label}</a>)}
      </nav>
    )}
    <div class="header-actions">
      {hasCaseNav && <button class="menu-toggle case-menu-toggle" type="button" data-menu-label="案例目录" aria-label="打开案例目录" aria-expanded="false" aria-controls="case-nav"><span>目录</span><span class="menu-icon" aria-hidden="true">+</span></button>}
      {detail ? <a class="back-link" href="/#work" aria-label="返回全部项目" title="返回全部项目"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 6-6 6 6 6M6 12h12" /></svg><span class="back-link-label">全部项目</span></a> : (
        <nav id="site-nav" class="site-nav" aria-label="主导航">
          <a href="#work" data-nav-link>项目 <span>01</span></a>
          <a href="#approach" data-nav-link>方法 <span>02</span></a>
          <a href="#about" data-nav-link>关于 <span>03</span></a>
          <a class="nav-contact" href="https://github.com/crybaby912" target="_blank" rel="noreferrer">GitHub ↗</a>
        </nav>
      )}
      <button class="theme-toggle" type="button" data-theme-toggle hidden aria-label="深色模式" aria-pressed="false" title="切换为深色模式">
        <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.8 13A8.9 8.9 0 0 1 11 3.2 9 9 0 1 0 20.8 13Z" /></svg>
        <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      {!detail && <button class="menu-toggle" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="site-nav"><span>菜单</span><span class="menu-icon" aria-hidden="true">+</span></button>}
    </div>
  </div>
</header>
<script>
  import '../scripts/site';
</script>
