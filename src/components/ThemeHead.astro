<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#f6f8f5" />
<!-- Resolve the preference before first paint, without waiting for the page bundle. -->
<script is:inline>
  (() => {
    let preference;
    try { preference = localStorage.getItem('portfolio-theme'); } catch { /* Storage is optional. */ }
    const theme = preference === 'light' || preference === 'dark'
      ? preference
      : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#101917' : '#f6f8f5');
  })();
</script>
