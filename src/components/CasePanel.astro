---
interface Props {
  eyebrow: string;
  title: string;
  body?: string;
  tags?: string[];
}
const { eyebrow, title, body, tags = [] } = Astro.props;
---
<article class="case-panel" data-detail-reveal>
  <p class="case-kicker">{eyebrow}</p>
  <h3>{title}</h3>
  {body && <p class="case-body">{body}</p>}
  <slot />
  {tags.length > 0 && <ul class="case-tags" aria-label="相关技术与产物">{tags.map((tag) => <li>{tag}</li>)}</ul>}
</article>
<style>
  .case-panel { display: flex; flex-direction: column; min-width: 0; padding: var(--case-padding); border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--paper-bright); overflow-wrap: anywhere; }
  .case-kicker { margin: 0 0 10px; color: var(--teal); font-size: 12px; font-weight: 600; }
  h3 { margin: 0 0 12px; font-size: 20px; font-weight: 680; line-height: 1.45; }
  .case-body { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.85; }
  .case-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; }
  .case-tags li { max-width: 100%; padding: 5px 10px; border-radius: 999px; background: var(--paper-deep); color: var(--muted); font-size: 11px; line-height: 1.65; }
  @media (max-width: 680px) {
    h3 { font-size: 19px; }
    .case-body { font-size: 16px; }
  }
</style>
