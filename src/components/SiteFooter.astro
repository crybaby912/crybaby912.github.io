---
interface Props {
  note?: string;
  showBackToTop?: boolean;
}
const { note = '使用 Astro 构建 · 用证据记录工程过程', showBackToTop = true } = Astro.props;
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-meta"><span>© 2026 CRYBABY912</span><span>{note}</span></div>
    <div class="footer-actions">
      {showBackToTop && (
        <a class="back-to-top" href="#top" aria-label="回到顶部" title="回到顶部">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 12 6-6 6 6M12 6v12" /></svg>
        </a>
      )}
    </div>
  </div>
</footer>
<style>
  .site-footer { color: var(--muted); font-size: 11px; }
  .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 24px; }
  .footer-meta { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .footer-actions { display: flex; flex-shrink: 0; align-items: center; gap: 12px; }
  .back-to-top { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%; background: var(--paper-bright); color: var(--teal); transition: background 200ms, border-color 200ms; }
  .back-to-top svg { transition: transform 240ms var(--ease-settle); }
  .back-to-top:hover { border-color: var(--teal); background: var(--paper-deep); }
  .back-to-top:hover svg { transform: translateY(-2px); }
  .back-to-top:active svg { transform: translateY(0); }
  @media (max-width: 680px) {
    .footer-inner { flex-wrap: wrap; gap: 16px; }
    .footer-meta { flex-direction: column; gap: 4px; }
  }
</style>
